APP_ENV=production
APP_DEBUG=false
# Fallback técnico da origem pública. A configuração salva por um administrador
# em Configurações → Sistema tem prioridade sobre este valor.
APP_URL=https://hotspot.example.invalid
APP_TZ=America/Manaus
# Segredo próprio para hashes de segurança do painel (32 bytes aleatórios em base64).
APP_KEY=
# Geradas pelo CLI initialize_internal_security_keys.php.
INTERNAL_API_KEY=
ACCOUNT_DELETION_AUDIT_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=firespot
DB_USERNAME=firespot
DB_PASSWORD=

# Opcional: conexão AAA separada. O guia preenche o mesmo banco e outra conta.
# Se HOST/NAME estiverem vazios, o PHP usa a conexão DB_* como fallback.
RADIUS_DB_HOST=
RADIUS_DB_NAME=
RADIUS_DB_USER=
RADIUS_DB_PASS=

# Base64 de 32 bytes aleatórios. Não reutilize o Access Token como chave.
# Exemplo de geração: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
PAYMENT_CREDENTIAL_KEY=
# Opcionalmente use uma chave separada para nome/telefone dos leads.
# Se vazia, a aplicação usa PAYMENT_CREDENTIAL_KEY como fallback de rollout.
PERSONAL_DATA_KEY=
# Segredo HMAC para provas e pseudonimização de entregas publicitárias.
AD_PROOF_KEY=

# Carteira global/fallback já utilizada pelos portais atuais.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Marco de ativação da exigência de assinatura para pedidos novos.
MERCADOPAGO_WEBHOOK_SIGNATURE_REQUIRED_AFTER=
# Credenciais da aplicação Marketplace usadas no OAuth dos estabelecimentos.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_API_BASE=https://api.mercadopago.com
MP_NOTIFICATION_URL=

# Mensageiro já existente. Mantém-se desabilitado até configuração explícita.
PROMO_ENABLED=false
PROMO_API_BASE=
PROMO_API_USER=
PROMO_API_HASH=

# Recuperação pública permanece fail-closed até haver transporte configurado.
HOST_PASSWORD_RESET_ENABLED=false
HOST_MAIL_FROM=no-reply@seu-dominio.example

ROS_HOST=
ROS_USER=
ROS_PASS=
ROS_PORT=22
# Fuso usado pelo módulo Expiration do FreeRADIUS (deve coincidir com o servidor RADIUS)
RADIUS_TIMEZONE=America/Manaus

# Probe operacional dedicado da cortesia. Use um client RADIUS restrito ao
# host do FireSpot e um segredo exclusivo; o comando não usa segredos dos NAS.
COURTESY_RADIUS_PROBE_HOST=127.0.0.1
COURTESY_RADIUS_PROBE_AUTH_PORT=1812
COURTESY_RADIUS_PROBE_ACCT_PORT=1813
COURTESY_RADIUS_PROBE_NAS_IP=127.0.0.1
COURTESY_RADIUS_PROBE_SECRET=
